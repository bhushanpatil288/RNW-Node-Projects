{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["airbnb-base", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^(next|req|res)$" }],
    "no-param-reassign": ["error", { "props": false }],
    "consistent-return": "off",
    "func-names": "off",
    "import/no-dynamic-require": "off",
    "global-require": "off",
    "class-methods-use-this": "off"
  }
}

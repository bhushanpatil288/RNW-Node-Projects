<nav class="mb-8 flex items-center justify-between rounded-b-2xl border border-slate-200 bg-white/80 px-6 py-4 shadow-sm backdrop-blur">
  <a href="/" class="text-xl font-semibold tracking-tight text-slate-800">Blog App</a>

  <div class="flex items-center gap-4 text-sm font-medium">
    <% if (user) { %>
      <span class="text-slate-600">Hello, <strong class="text-slate-800"><%= user.username %></strong></span>
      <a href="/logout" class="rounded-md px-3 py-2 text-red-600 transition hover:bg-red-50">Logout</a>
    <% } else { %>
      <a href="/login" class="rounded-md px-3 py-2 text-sky-600 transition hover:bg-sky-50">Login</a>
      <a href="/register" class="rounded-md px-3 py-2 text-sky-600 transition hover:bg-sky-50">Register</a>
    <% } %>
  </div>
</nav>
